.bw-cell{position:relative;min-width:0;min-height:0;box-sizing:border-box;container-type:size}
.bw-b{position:absolute;left:50%;top:50%;width:min(100cqw,100cqh);aspect-ratio:1;border-radius:50%;cursor:pointer;
transform:translate(-50%,-50%) scale(1);transition:transform .45s cubic-bezier(.34,1.56,.64,1),background .2s ease;transition-delay:var(--d,0s);
background:radial-gradient(circle at 32% 28%,${aa(95)} 0 9%,${aa(35)} 14%,${aa(12)} 46%,${aa(22)} 70%,${aa(45)} 100%);
box-shadow:inset -2px -6px 10px rgba(42,29,23,.10),2px 6px 8px -6px rgba(42,29,23,.35);border:1px solid ${aa(55)}}
@media (hover:hover){.bw-b:not(.bw-p):hover{transform:translate(-50%,-50%) scale(1.06)}}
.bw-b.bw-p{cursor:default;transform:translate(-50%,-50%) scale(.82);background:${aa(10)};box-shadow:none;border:1px dashed ${aa(60)};transition-delay:0s}
.bw-b.bw-p::before,.bw-b.bw-p::after{content:"";position:absolute;left:22%;right:22%;top:48%;height:2px;border-radius:2px;background:${aa(65)};transform:rotate(18deg)}
.bw-b.bw-p::after{top:40%;transform:rotate(-24deg)}
.bw-b.bw-f{animation:bw-squish .42s cubic-bezier(.3,1.4,.6,1) both}
.bw-ring{position:absolute;inset:-22%;border-radius:50%;border:3px solid ${aa(95)};pointer-events:none;animation:bw-ring .45s ease-out both}
.bw-card{position:absolute;z-index:3;box-sizing:border-box;animation:bw-in .55s cubic-bezier(.3,1.5,.55,1) both}
.bw-card.bw-out{animation:bw-out .22s ease-in both;pointer-events:none}
.bw-x{position:absolute;top:12px;right:12px;width:28px;height:28px;border-radius:50%;border:0;padding:0;cursor:pointer;display:grid;place-items:center;font:inherit;line-height:1;z-index:2}
.bw-go{display:inline-flex;align-items:center;gap:10px;padding:8px 8px 8px 16px;border-radius:999px;text-decoration:none;align-self:flex-start;flex:none;
transition:transform .35s cubic-bezier(.34,1.56,.64,1)}
.bw-go:hover{transform:scale(1.04)}
.bw-go i{width:26px;height:26px;border-radius:50%;display:grid;place-items:center;font-style:normal}
.bw-clamp{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:3;overflow:hidden}
.bw-pic{width:100%;height:170px;border-radius:16px;object-fit:cover;display:block;flex:none}
.bw-photo{width:100%;height:250px;border-radius:18px;object-fit:cover;display:block;flex:none}
@keyframes bw-squish{0%{transform:translate(-50%,-50%) scale(1)}35%{transform:translate(-50%,-50%) scale(1.14,.68)}100%{transform:translate(-50%,-50%) scale(.82)}}
@keyframes bw-ring{0%{transform:scale(.55);opacity:.95}100%{transform:scale(1.25);opacity:0}}
@keyframes bw-in{0%{opacity:0;transform:scale(.12) rotate(0deg)}55%{opacity:1;transform:scale(1.05) rotate(var(--r))}100%{opacity:1;transform:scale(1) rotate(var(--r))}}
@keyframes bw-out{to{opacity:0;transform:scale(.6) rotate(var(--r))}}
@container (max-height: 2px){.bw-b{display:none}}
@media (prefers-reduced-motion:reduce){.bw-b,.bw-b.bw-f{transition:none;animation:none}.bw-ring{display:none}.bw-card{animation:none}.bw-card.bw-out{display:none}}
